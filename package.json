{
  "name": "worksphere",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @worksphere/api",
    "dev:web": "npm run dev -w @worksphere/web",
    "build": "npm run build -w @worksphere/api && npm run build -w @worksphere/web",
    "build:api": "npm run build -w @worksphere/api",
    "start": "npm run start:prod -w @worksphere/api",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w @worksphere/api",
    "db:seed": "npm run db:seed -w @worksphere/api",
    "deploy:api": "railway up --ci",
    "deploy:web": "npm run build -w @worksphere/web && vercel --prod --yes --cwd apps/web",
    "deploy": "npm run deploy:api && npm run deploy:web"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
