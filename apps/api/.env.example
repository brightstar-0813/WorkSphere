DATABASE_URL="postgresql://worksphere:worksphere@localhost:5432/worksphere?schema=public"
JWT_SECRET="worksphere-dev-secret-change-me"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
API_PUBLIC_URL="http://localhost:4000"

SEED_ADMIN_EMAIL="admin@worksphere.local"
SEED_ADMIN_PASSWORD="admin123"
SEED_USER_EMAIL="user@worksphere.local"
SEED_USER_PASSWORD="user123"

# --- Gmail / Google Calendar OAuth ---
# Create at https://console.cloud.google.com/apis/credentials
# Enable: Google Calendar API + Gmail API
# OAuth scopes used: calendar.events, calendar.readonly, gmail.send, email, profile
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/integrations/google/callback"

# --- Outlook / Microsoft 365 OAuth ---
# Create app at https://portal.azure.com → App registrations
# API permissions: Calendars.ReadWrite, Mail.Send, User.Read (delegated) + offline_access
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_TENANT_ID="common"
# MICROSOFT_REDIRECT_URI="http://localhost:4000/api/v1/integrations/outlook/callback"

# --- Optional: SMTP fallback for calendar share invites ---
# Prefer connected Gmail/Outlook (above) — Gmail API uses HTTPS and works when
# outbound SMTP is blocked by ISP/firewall (common locally).
# For Gmail SMTP: use an App Password (not your login password).
# Without either, WorkSphere still creates an invite link (copy from UI / server log).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="WorkSphere <noreply@example.com>"
